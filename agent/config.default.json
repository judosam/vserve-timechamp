{
  "project": "vserve-timechamp",
  "version": "1.2.0",
  "agent": {
    "user": "",
    "machine": "",
    "localDataPath": "%LOCALAPPDATA%\\VserveTimeChamp",
    "tickIntervalSeconds": 30,
    "idleThresholdSeconds": 600,
    "stateFlushIntervalSeconds": 30,
    "syncIntervalSeconds": 900,
    "logLevel": "INFO",
    "maxLogSizeBytes": 5242880,
    "maxRotatedLogs": 3,
    "enableAppTracking": true,
    "enableBrowserUrlTracking": true,
    "enableScreenshots": false,
    "screenshotIntervalSeconds": 600,
    "screenshotBlur": false,
    "enableWatchdog": true,
    "watchdogIntervalSeconds": 60
  },
  "productivityRules": {
    "productiveApps": [
      "code.exe",
      "devenv.exe",
      "idea64.exe",
      "excel.exe",
      "winword.exe",
      "powerpnt.exe",
      "teams.exe",
      "slack.exe",
      "outlook.exe",
      "antigravity.exe",
      "powershell.exe",
      "cmd.exe",
      "windowsterminal.exe"
    ],
    "unproductiveApps": [
      "spotify.exe",
      "steam.exe",
      "epicgameslauncher.exe",
      "discord.exe"
    ],
    "productiveUrls": [
      "github.com",
      "gitlab.com",
      "bitbucket.org",
      "stackoverflow.com",
      "learn.microsoft.com",
      "docs.google.com",
      "jira",
      "confluence",
      "vservesolution.com"
    ],
    "unproductiveUrls": [
      "facebook.com",
      "instagram.com",
      "twitter.com",
      "x.com",
      "tiktok.com",
      "netflix.com",
      "reddit.com"
    ]
  },
  "sync": {
    "transport": "Share",
    "share": {
      "centralPath": "\\\\server\\worktime"
    },
    "graph": {
      "tenantId": "",
      "clientId": "",
      "clientSecret": "",
      "driveId": "",
      "folderPath": "VserveTimeChamp"
    },
    "googleDrive": {
      "serviceAccountKeyPath": "",
      "folderId": ""
    }
  }
}
